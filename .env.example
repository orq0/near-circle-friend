# Near-Circle environment template — copy to `.env` and adjust. Never commit `.env`.

# ---- Host ports (change if anything conflicts on your machine) ----
WEB_PORT=5173
API_PORT=3001
POSTGRES_PORT=5433
# 5001 is avoided: commonly occupied by unrelated OSRM instances.
ROUTING_WALK_PORT=5002

# ---- PostgreSQL (project-local dev credentials; not production secrets) ----
POSTGRES_USER=near_circle
POSTGRES_PASSWORD=near_circle_dev_password
POSTGRES_DB=near_circle

# ---- Routing provider (Phase 1: scaffolded, graph prepared in Phase 3) ----
ROUTING_PROVIDER=osrm
# In-Compose URL (service name resolves on the project Docker network):
ROUTING_WALK_URL=http://near-circle-routing-walk:5000
# Host URL for direct development tests:
ROUTING_WALK_HOST_URL=http://localhost:5002

# ---- Map tiles (external, configurable; NOT started by startall) ----
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# ---- Estimates ----
DEFAULT_STRIDE_M=0.75

# ---- Frontend -> API ----
# In dev the Vite server proxies /api to the API; override only if needed.
VITE_API_URL=
# Vite /api proxy target. Native dev defaults to http://localhost:3001 (see
# apps/web/vite.config.ts); Compose sets http://near-circle-api:3001 because
# localhost inside the web container is the web container itself.
# VITE_API_PROXY_TARGET=http://localhost:3001

# ---- AI Circle Intelligence (optional add-on; works keyless in demo mode) ----
# Live inference uses Muse Spark 1.3 via Meta Model API. Without a key, stored
# fixture profiles still read and the advisor returns labeled demo results.
AI_CIRCLE_ENABLED=1
AI_CIRCLE_DEMO_MODE=1
META_MODEL_NAME=muse-spark-1.3
META_MODEL_BASE_URL=https://api.meta.ai/v1
AI_CIRCLE_TIMEOUT_MS=20000
AI_CIRCLE_MAX_TOKENS=2048
AI_CIRCLE_REASONING_EFFORT=low
# Coleen-only synthetic demo context for the judge Reconnect Today flow
# (target-side window + interests; never fabricates your availability).
AI_CIRCLE_DEMO_AVAILABILITY=1
AI_CIRCLE_COOLDOWN_DAYS=14
AI_CIRCLE_USER_REFRESH_PER_DAY=1
AI_CIRCLE_ADVICE_TTL_MIN=30
AI_CIRCLE_ADVICE_PER_USER_DAY=20
AI_CIRCLE_ADVICE_PAIR_WINDOW_HOURS=6
AI_CIRCLE_DAILY_REQUEST_BUDGET=100
# Server-side credential. Never commit a real value.
# MODEL_API_KEY=

# ---- API -> Database (native development) ----
# The API builds its connection string from DATABASE_URL when set, otherwise
# from the POSTGRES_* parts below with these same defaults. Native `npm run
# dev:api` needs no configuration when the Compose database uses default ports.
# DATABASE_URL=postgresql://near_circle:near_circle_dev_password@localhost:5433/near_circle
# POSTGRES_HOST=localhost
