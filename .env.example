# Near-Circle environment template — copy to `.env` and adjust. Never commit `.env`.

# ---- Host ports (change if anything conflicts on your machine) ----
WEB_PORT=5173
API_PORT=3001
POSTGRES_PORT=5433
ROUTING_WALK_PORT=5001

# ---- PostgreSQL (project-local dev credentials; not production secrets) ----
POSTGRES_USER=near_circle
POSTGRES_PASSWORD=near_circle_dev_password
POSTGRES_DB=near_circle

# ---- Routing provider (Phase 1: scaffolded, graph prepared in Phase 3) ----
ROUTING_PROVIDER=osrm
# In-Compose URL (service name resolves on the project Docker network):
ROUTING_WALK_URL=http://near-circle-routing-walk:5000
# Host URL for direct development tests:
ROUTING_WALK_HOST_URL=http://localhost:5001

# ---- Map tiles (external, configurable; NOT started by startall) ----
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# ---- Estimates ----
DEFAULT_STRIDE_M=0.75

# ---- Frontend -> API ----
# In dev the Vite server proxies /api to the API; override only if needed.
VITE_API_URL=

# ---- API -> Database (native development) ----
# The API builds its connection string from DATABASE_URL when set, otherwise
# from the POSTGRES_* parts below with these same defaults. Native `npm run
# dev:api` needs no configuration when the Compose database uses default ports.
# DATABASE_URL=postgresql://near_circle:near_circle_dev_password@localhost:5433/near_circle
# POSTGRES_HOST=localhost
